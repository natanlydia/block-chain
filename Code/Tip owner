contract Contract {
    address public owner;

    constructor(){
           owner = msg.sender;
    }
      receive() external payable {}

      function tip() public payable {
        require(msg.value > 0, "Tip amount must be greater than zero");

        
        (bool success, ) = owner.call{value: msg.value}("");
        require(success, "Transfer failed");
    }
}
